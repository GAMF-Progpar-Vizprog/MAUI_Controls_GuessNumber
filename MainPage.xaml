<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MAUIGuessNumber"
             x:Class="MAUIGuessNumber.MainPage">
	<!-- Grid a külső elrendezés: a VerticalStackLayout nem korlátozza a magasságot,
	     ezért benne a CollectionView nem görgetne -->
	<Grid RowDefinitions="Auto,Auto,Auto,*" Margin="20">
		<Label Grid.Row="0" Text="Guess which four digit number I meant"
			HorizontalOptions="Center" HorizontalTextAlignment="Center"
			FontSize="18"/>
		<Grid Grid.Row="1" Margin="0,20,0,20" ColumnDefinitions="*,Auto,Auto">
			<Entry x:Name="enNumber" Grid.Column="0" Keyboard="Numeric" MaxLength="4"
				Completed="btOK_Clicked"/>
			<Button Text="OK" Clicked="btOK_Clicked" Grid.Column="1" Margin="20,0,20,0"/>
			<Button Text="New" Clicked="btNewGame_Clicked" Grid.Column="2"
				HorizontalOptions="End"/>
		</Grid>
		<Label Grid.Row="2" x:Name="llResult"/>
		<CollectionView Grid.Row="3" x:Name="cvResults" Margin="0,20,0,0">
			<CollectionView.Header>
				<Grid ColumnDefinitions="80,80,120">
					<Label Grid.Column="0" Text="Attempt"
						FontAttributes="Bold" HorizontalTextAlignment="Center"/>
					<BoxView Grid.Column="0" BackgroundColor="Black"
						HeightRequest="1" VerticalOptions="End"/>
					<Label Grid.Column="1" Text="Correct" FontAttributes="Bold"
						HorizontalTextAlignment="Center"/>
					<BoxView Grid.Column="1" BackgroundColor="Black"
						HeightRequest="1" VerticalOptions="End"/>
					<Label Grid.Column="2" Text="Correct location" FontAttributes="Bold"
						HorizontalTextAlignment="Center"/>
					<BoxView Grid.Column="2" BackgroundColor="Black"
						HeightRequest="1" VerticalOptions="End"/>
				</Grid>
			</CollectionView.Header>
			<CollectionView.ItemTemplate>
				<DataTemplate x:DataType="local:Result">
					<Grid ColumnDefinitions="80,80,120" Padding="0,4">
						<Label Grid.Column="0" Text="{Binding Guess}"
							HorizontalTextAlignment="Center"/>
						<Label Grid.Column="1" Text="{Binding CorrectDigits}"
							HorizontalTextAlignment="Center" />
						<Label Grid.Column="2" Text="{Binding CorrectPositions}"
							HorizontalTextAlignment="Center"/>
					</Grid>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>
	</Grid>
</ContentPage>
