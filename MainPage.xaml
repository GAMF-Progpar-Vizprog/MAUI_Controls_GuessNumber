<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MAUI_Controls_GuessNumber"
             x:Class="MAUI_Controls_GuessNumber.MainPage">
	<ContentPage.Resources>
		<!-- A táblázat celláinak közös beállításai -->
		<Style x:Key="Cell" TargetType="Label">
			<Setter Property="HorizontalTextAlignment" Value="Center"/>
		</Style>
		<Style x:Key="HeaderCell" TargetType="Label" BasedOn="{StaticResource Cell}">
			<Setter Property="FontAttributes" Value="Bold"/>
			<Setter Property="TextDecorations" Value="Underline"/>
		</Style>
	</ContentPage.Resources>
	<!-- Grid a külső elrendezés: a VerticalStackLayout nem korlátozza a magasságot,
	     ezért benne a CollectionView nem görgetne -->
	<Grid RowDefinitions="Auto,Auto,Auto,*" Margin="20">
		<Label Grid.Row="0" Text="Guess which four digit number I meant"
			HorizontalOptions="Center" HorizontalTextAlignment="Center"
			FontSize="18"/>
		<Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="20"
			Margin="0,10,0,10">
			<Entry x:Name="enNumber" Keyboard="Numeric" MaxLength="4"
				Completed="btOK_Clicked"/>
			<Button Grid.Column="1" Text="OK" Clicked="btOK_Clicked"/>
			<Button Grid.Column="2" Text="New" Clicked="btNewGame_Clicked"/>
		</Grid>
		<Label Grid.Row="2" x:Name="llResult"/>
		<CollectionView Grid.Row="3" x:Name="cvResults" Margin="0,20,0,0">
			<CollectionView.Header>
				<Grid ColumnDefinitions="80,80,120">
					<Label Text="Attempt" Style="{StaticResource HeaderCell}"/>
					<Label Grid.Column="1" Text="Correct" Style="{StaticResource HeaderCell}"/>
					<Label Grid.Column="2" Text="Correct location"
						Style="{StaticResource HeaderCell}"/>
				</Grid>
			</CollectionView.Header>
			<CollectionView.ItemTemplate>
				<DataTemplate x:DataType="local:Result">
					<Grid ColumnDefinitions="80,80,120" Padding="0,4">
						<Label Text="{Binding Guess}" Style="{StaticResource Cell}"/>
						<Label Grid.Column="1" Text="{Binding CorrectDigits}"
							Style="{StaticResource Cell}"/>
						<Label Grid.Column="2" Text="{Binding CorrectPositions}"
							Style="{StaticResource Cell}"/>
					</Grid>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>
	</Grid>
</ContentPage>
